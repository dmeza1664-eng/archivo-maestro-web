# Pronóstico automático — ejemplo de configuración.
# Copia este archivo como .env.pronostico en la raíz del repo (git lo ignora) o
# define las variables en el sistema / programador de tareas. NUNCA subas al
# repo un archivo con la contraseña real.

# Fuente: "archivos" (extractos CSV) o "base" (copia espejo de pepes_devBI).
PEPES_FUENTE=archivos

# --- Modo archivos ---
# Carpetas con los extractos (separadas por ":" o ","; en Windows por ";").
PEPES_DATOS_DIRS=/ruta/extract-pepes-2024:/ruta/pepes-devBI-extract-2025:/ruta/validacion-2026/extract

# --- Modo base (SQL Server, usuario de solo lectura) ---
PEPES_DB_SERVER=
PEPES_DB_NAME=pepes_devBI
PEPES_DB_USER=
PEPES_DB_PASSWORD=
# Opcionales:
# PEPES_DB_PORT=1433
# PEPES_DB_ENCRYPT=true
# PEPES_DB_TRUST_SERVER_CERT=false
# PEPES_DB_TIMEOUT_MS=300000

# --- Comunes (opcionales) ---
# Catálogo stock_ideal (xlsx o json). Por defecto: wape-excel/stock_ideal.xlsx
# PEPES_STOCK_IDEAL=/ruta/stock_ideal.xlsx
# Inicio de la serie oficial (la espejo trae movimientos desde 2024-01-01).
# PEPES_DESDE=2024-01
# Carpeta de salidas. Por defecto: salidas/pronostico-automatico
# PEPES_SALIDA_DIR=/ruta/salidas
# Solo para repetir un corte pasado o forzar el mes a pronosticar:
# PEPES_FECHA_CORTE=2026-08-31
# PEPES_MESES_OBJETIVO=2026-09
