{
  "name": "Archivo Maestro Web",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && npm run dev",
      "description": "API Node.js + Express (MySQL) en http://localhost:4000"
    },
    {
      "name": "frontend",
      "command": "npm run dev",
      "description": "Vite + React dev server en http://localhost:5173"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 5173 },
    { "name": "backend", "port": 4000 }
  ]
}
